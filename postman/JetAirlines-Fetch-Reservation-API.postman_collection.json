    {
      "name": "Commands (run in order)",
      "item": [
        {
          "name": "1. Create reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations"
              ]
            },
            "description": "Saves newRecordLocator, newPassengerId, newSegmentId for the next requests. Run these in order.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactEmail\": \"test.user@example.com\",\n  \"contactPhone\": \"+1 214 555 0199\",\n  \"passengers\": [\n    {\n      \"firstName\": \"Test\",\n      \"lastName\": \"User\",\n      \"passengerType\": \"ADULT\",\n      \"loyaltyNumber\": \"JM1112223\"\n    }\n  ],\n  \"segments\": [\n    {\n      \"flightNumber\": \"JT101\",\n      \"origin\": \"DFW\",\n      \"destination\": \"JFK\",\n      \"departureTime\": \"{{day1}}T08:00:00\",\n      \"arrivalTime\": \"{{day1}}T12:35:00\",\n      \"cabin\": \"ECONOMY\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('newRecordLocator', r.recordLocator);",
                  "if (r.passengers && r.passengers.length) pm.collectionVariables.set('newPassengerId', r.passengers[0].id);",
                  "if (r.segments && r.segments.length) pm.collectionVariables.set('newSegmentId', r.segments[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Update contact",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{newRecordLocator}}/contact",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations",
                "{{newRecordLocator}}",
                "contact"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactEmail\": \"updated.user@example.com\",\n  \"contactPhone\": \"+1 214 555 0100\"\n}",
              "options": {
