  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Seed data uses dates relative to today; compute them so date params always match.",
          "const pad = n => String(n).padStart(2, '0');",
          "const day = k => { const d = new Date(); d.setDate(d.getDate() + k); return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; };",
          "[1,2,3,5].forEach(k => pm.collectionVariables.set('day' + k, day(k)));"
        ]
      }
    }
  ],
