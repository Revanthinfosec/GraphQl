{
  "info": {
    "name": "JetAirlines Fetch Reservation API",
    "description": "All 15 endpoints of jetairlines-fetch-reservation-api (Spring Boot, port 8081). Seed data is in-memory and resets on restart. Switch recordLocator/lastName in the collection variables to try other seeded bookings: JTK7QP Martinez, JTM4XR Nair, JTZ8LC Chen, JTP2NV Nair, JTC9WD Kim (cancelled), JTR6PA Rossi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Lookups",
      "item": [
        {
          "name": "Get by record locator",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{recordLocator}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations",
                "{{recordLocator}}"
              ]
            },
            "description": "GET /api/reservations/{recordLocator}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
